{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "my_game_hub",
	"version": "1.0.0",
	"description": "A game hub for managing and playing your favorite games",
	"license": "MIT",
	"private": false,
	"author": "Álvaro Davi Santos Alves <alvaro-davi1@hotmail.com>",
	"contributors": [
		"Álvaro Davi Santos Alves <alvaro-davi1@hotmail.com>"
	],
	"repository": "https://github.com/AlvaroDavi5/MyGameHub.git",
	"main": "./src/root.tsx",
	"type": "module",
	"engineStrict": true,
	"engines": {
		"node": ">=24.0.x <=24.x.x",
		"npm": ">=12.0.x <=12.x.x",
		"yarn": "0"
	},
	"os": [
		"linux",
		"ubuntu",
		"win32"
	],
	"keywords": [
		"boilerplate",
		"node",
		"typescript",
		"javascript",
		"reactjs"
	],
	"scripts": {
		"typecheck": "react-router typegen && tsc --project tsconfig.json --noEmit",
		"build": "react-router build",
		"start": "react-router-serve ./build/server/index.js",
		"start:dev": "react-router dev",
		"security-check": "node scripts/security-check.ts",
		"test": "npm run test:unit && npm run test:render",
		"test:watch": "vitest watch",
		"test:coverage": "npm run test:unit:coverage && npm run test:render:coverage",
		"test:unit": "vitest run tests/unit",
		"test:unit:watch": "vitest watch tests/unit",
		"test:unit:coverage": "vitest run tests/unit --coverage --coverage.reportsDirectory=coverage/unit",
		"test:render": "vitest run tests/render",
		"test:render:watch": "vitest watch tests/render",
		"test:render:coverage": "vitest run tests/render --coverage --coverage.reportsDirectory=coverage/render",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"lint:strict": "oxlint --deny-warnings",
		"format": "oxfmt --check",
		"format:fix": "oxfmt --write",
		"postinstall": "react-router typegen"
	},
	"dependencies": {
		"@chakra-ui/react": "^3.37.0",
		"@emotion/react": "^11.14.0",
		"@react-router/node": "^8",
		"@react-router/serve": "^8",
		"isbot": "^5.1.36",
		"next-themes": "^0.4.6",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-icons": "^5.7.0",
		"react-router": "^8"
	},
	"devDependencies": {
		"@react-router/dev": "^8",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/node": "^22",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.1.1",
		"@vitest/coverage-v8": "^5.0.0",
		"jsdom": "^30.0.1",
		"oxfmt": "^0.66.0",
		"oxlint": "^1.81.0",
		"typescript": "^5.9.3",
		"vite": "^8.0.3",
		"vitest": "^5.0.0"
	}
}