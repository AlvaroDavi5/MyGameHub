{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "./tsconfig.base.json",
	"include": [
		"./*.config.ts",
		".react-router/types/**/*",
		"app/**/*",
		"app/**/.server/**/*",
		"app/**/.client/**/*",
		"scripts/**/*.ts",
		"tests/**/*"
	],
	"exclude": [
		"node_modules",
		"build",
		"coverage"
	]
}