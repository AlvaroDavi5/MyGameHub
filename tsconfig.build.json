{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "./tsconfig.base.json",
	"include": [
		".react-router/types/**/*",
		"app/**/*",
		"app/**/.server/**/*",
		"app/**/.client/**/*"
	],
	"exclude": [
		"node_modules",
		"build",
		"coverage",
		"scripts",
		"tests",
		"**/*.test.ts",
		"**/*.test.tsx"
	]
}