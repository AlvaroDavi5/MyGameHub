{
	"$schema": "https://json.schemastore.org/tsconfig",
	"compilerOptions": {
		/* Language and Environment */
		"target": "ES2022",
		"lib": [
			"DOM",
			"DOM.Iterable",
			"ES2022"
		],
		"types": [
			"node",
			"vite/client"
		],
		"jsx": "react-jsx",
		/* Modules */
		"module": "ES2022",
		"moduleResolution": "bundler",
		"rootDirs": [
			".",
			"./.react-router/types"
		],
		"paths": {
			"@components/*": [
				"./app/components/*"
			],
			"@configs/*": [
				"./app/configs/*"
			],
			"@assets/*": [
				"./app/assets/*"
			]
		},
		"resolveJsonModule": true,
		/* Emit */
		"noEmit": true,
		/* Interop Constraints */
		"isolatedModules": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"verbatimModuleSyntax": true,
		"forceConsistentCasingInFileNames": true,
		/* Type Checking */
		"strict": true,
		"noImplicitReturns": true,
		/* Completeness */
		"skipLibCheck": true,
		"pretty": true
	},
	"exclude": [
		"node_modules",
		"build",
		"coverage",
		".react-router/**/*.js"
	]
}