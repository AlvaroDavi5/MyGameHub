{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "ReactJS: debug server-side",
			"type": "node-terminal",
			"request": "launch",
			"command": "npm run start:dev"
		},
		{
			"name": "ReactJS: debug client-side",
			"type": "chrome",
			"request": "launch",
			"webRoot": "${workspaceFolder}",
			"url": "http://localhost:3001"
		},
		{
			"name": "ReactJS: debug full stack",
			"type": "node-terminal",
			"request": "launch",
			"command": "npm run start:dev",
			"serverReadyAction": {
				"pattern": "- Local:.+(https?://.+)",
				"uriFormat": "%s",
				"action": "debugWithChrome"
			}
		}
	]
}